{
  "name": "refract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.desktop.json && vite build",
    "start": "electron .",
    "test": "node --import tsx --test src/core/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src desktop",
    "build:native": "./scripts/build-native.sh",
    "package": "npm run build:native && npm run build && node --import tsx scripts/package.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.8",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  }
}
